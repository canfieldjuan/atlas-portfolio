node_modules

# Next.js build output
.next/
out/

# Vercel
.vercel

# Python audit-script byproduct (scripts/*.py)
__pycache__/
*.pyc

# Local secrets (never commit)
.env
.env.local

# Git worktrees created inside the repo (parallel sessions) — never commit
/worktrees/
